# Copy to `.env` on the server at /opt/shipops/.env and `chmod 600` it.
# This file is the ONLY place secrets live on the host. It is never committed.

# --- identity -------------------------------------------------------------
STACK_NAME=clientname
APP_DOMAIN=app.clientdomain.com
ACME_EMAIL=ops@clientdomain.com

# --- image ----------------------------------------------------------------
# Written by deploy.sh on every deploy. Always a digest or an immutable tag -
# never `latest`, or rollback becomes impossible.
APP_IMAGE=ghcr.io/client/app:sha-abc1234

# --- database -------------------------------------------------------------
# Which engine this stack runs: postgres | mysql | mongodb.
# The backup scripts auto-detect from the running container, so this is only
# needed when detection is ambiguous - but set it anyway, it costs nothing and
# makes the stack self-describing.
DB_ENGINE=postgres

# Generate every password with: openssl rand -base64 32

# Postgres (the default)
POSTGRES_USER=appuser
POSTGRES_DB=appdb
POSTGRES_PASSWORD=CHANGE_ME

# MySQL / MariaDB - see compose/db-alternatives.yml
# MYSQL_DATABASE=appdb
# MYSQL_USER=appuser
# MYSQL_PASSWORD=CHANGE_ME
# MYSQL_ROOT_PASSWORD=CHANGE_ME

# MongoDB - see compose/db-alternatives.yml
# MONGO_DATABASE=appdb
# MONGO_INITDB_ROOT_USERNAME=appuser
# MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME

# --- resources (tune to the VPS; these fit a 4GB Hetzner CX22) -------------
APP_MEMORY_LIMIT=512M
POSTGRES_MEMORY_LIMIT=512M
REDIS_MAXMEMORY=128mb

# --- backups --------------------------------------------------------------
# The client's own bucket, in the client's own account. See PLAYBOOK.md §2.
BACKUP_BUCKET=s3://client-app-backups
BACKUP_RETENTION_DAYS=30

# ON AWS, PREFER AN IAM INSTANCE ROLE OVER KEYS.
# Attach a role to the EC2 instance and delete the two AWS_*_KEY lines below
# entirely. The CLI then takes short-lived credentials from instance metadata,
# so there is no long-lived secret on the machine to leak or rotate. Verified
# working on a real instance - see VERIFICATION.md.
#
# Scope the role's policy to s3:PutObject, s3:GetObject and s3:ListBucket on
# this bucket only, and deliberately WITHOUT s3:DeleteObject: a compromised
# server should not be able to destroy its own recovery path. Let the bucket's
# own lifecycle rule expire old objects, and set:
# BACKUP_PRUNE=off
# Set only if the database is legitimately empty - otherwise a dump containing
# no rows is treated as a failure, which is almost always what you want.
# BACKUP_ALLOW_EMPTY=1
# MongoDB only: the deep integrity check restores into a scratch database on the
# live server. Above this size it is skipped (with a loud warning) and the
# weekly restore test becomes the real proof. Default 500MB.
# MONGO_DEEP_VERIFY_MAX_BYTES=524288000
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Cloudflare R2 endpoint; omit entirely for real AWS S3.
AWS_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
AWS_DEFAULT_REGION=auto

# --- alerting (optional but strongly recommended) -------------------------
# A backup that fails silently is worse than no backup, because you believe
# you are covered. Point this at a Discord/Slack incoming webhook.
ALERT_WEBHOOK_URL=

# --- application ----------------------------------------------------------
# Client's own app secrets go below this line.
